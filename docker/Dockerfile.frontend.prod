# Stage 1: Build React Production Assets
FROM node:20-alpine as builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --prefer-offline --no-audit

COPY . .
RUN npm run build

# Stage 2: Serve with Hardened Nginx
FROM nginx:1.25-alpine as runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY infrastructure/nginx/conf.d/owasp_scan_pro.conf /etc/nginx/conf.d/default.conf

# Security Hardening: Remove default server tokens
RUN rm -rf /etc/nginx/conf.d/default.conf.bak /var/cache/apk/*

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --retries=3 \
  CMD wget -q --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
